{
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "diff_view_style": "split",
  "agent_servers": {
    "kiro-cli": {
      "favorite_models": [
        "claude-opus-4.7",
        "claude-opus-4.6",
        "claude-sonnet-4.6",
      ],
      "type": "custom",
      "command": "kiro-cli",
      "args": ["acp"],
    },
  },
  "context_servers": {
    "kiro-cli": {
      "enabled": false,
      "remote": false,
      "command": "kiro-cli-chat",
      "args": [],
      "env": {},
    },
  },
  "show_edit_predictions": false,
  "ssh_connections": [
    {
      "host": "cdd",
      "args": [],
      "projects": [
        {
          "paths": ["/home/ddeich/workspace/HPMS"],
        },
      ],
    },
  ],
  "autosave": {
    "after_delay": {
      "milliseconds": 300,
    },
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-opus-4-5",
    },
    "model_parameters": [],
  },
  "file_scan_exclusions": [
    ".brazil",
    ".bemol",
    ".builder-mcp",
    "build/",
    "env/",
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "ui_font_size": 15,
  "buffer_font_size": 15.0,
  "base_keymap": "JetBrains",
  "theme": {
    "mode": "dark",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark",
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "auto_install_extensions": {
    "html": true,
    "just": true,
    "codebook": true,
    "jetbrains-new-ui-icons": true,
    "jetbrains-themes": true,
    "kotlin": true,
    "go": true,
    "typescript": true,
    "smithy": true,
    "java": true,
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "jdtls": {
      "settings": {
        "java": {
          "jdt": {
            "ls": {
              "java.home": "/Library/Java/JavaVirtualMachines/amazon-corretto-25.jdk/Contents/Home",
            },
          },
        },
      },
    },
    "gopls": {
      "initialization_options": {
        "buildFlags": ["-tags=integration"],
        "directoryFilters": ["-**/build", "-**/.brazil"],
      },
    },
  },
  "languages": {
    "kotlin": {
      "language_servers": [
        "!kotlin-lsp",
        "!kotlin-language-server",
        "codebook",
      ],
    },
    "go": {
      "formatter": {
        "external": {
          "command": "gofmt",
          "arguments": ["-w", "-s", "{buffer_path}"],
        },
      },
    },
    "typescript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "Java": {
      "preferred_line_length": 120,
    },
  },
}
